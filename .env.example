# ToolPix Standalone Native Code Executor Backend Server Environment Configuration

# Secret Keys allowed to request code execution.
# Separate multiple keys with commas if multiple websites use different secret keys.
SERVER_API_KEYS=your-secret-api-key-here,another-website-secret-key

# Allowed CORS Origins (comma separated list of website URLs, or '*' for all origins)
# Note: toolpix.pythonanywhere.com and *.uthakkan.in are automatically allowed by default!
ALLOWED_ORIGINS=https://toolpix.pythonanywhere.com,https://uthakkan.in,*

# Code Execution Limits
EXECUTOR_MAX_CODE_BYTES=65536
EXECUTOR_MAX_OUTPUT_BYTES=200000
EXECUTOR_TIMEOUT_S=30

# Rate Limiting (Disabled by default: RATE_LIMIT_ENABLED=false)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX_REQUESTS=10000
