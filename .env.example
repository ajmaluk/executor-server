# ==============================================================================
# ToolPix Standalone Code Executor Server Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Security & Access Control
# ------------------------------------------------------------------------------
# Global Secret API Key required in 'X-API-Key' or 'Authorization: Bearer <key>'
GLOBAL_API_KEY=your-global-secret-key-here

# Allowed CORS Origins (comma-separated URLs, or '*' to allow all origins)
ALLOWED_ORIGINS=https://toolpix.pythonanywhere.com,https://uthakkan.in,*


# ------------------------------------------------------------------------------
# 2. Resource & Execution Safety Limits
# ------------------------------------------------------------------------------
# Maximum incoming code size per request (65536 bytes = 64 KB)
EXECUTOR_MAX_CODE_BYTES=65536

# Maximum stdout/stderr output captured per stream (200000 bytes = 200 KB)
EXECUTOR_MAX_OUTPUT_BYTES=200000

# Maximum stdin input size (10000 bytes = 10 KB)
EXECUTOR_MAX_STDIN_BYTES=10000

# Hard execution timeout per process in seconds (default: 30s)
EXECUTOR_TIMEOUT_S=30

# Maximum queue wait time before returning HTTP 503 Service Unavailable (default: 15s)
EXECUTOR_QUEUE_WAIT_S=15

# Maximum concurrent process executions on server (default: 8)
EXECUTOR_MAX_CONCURRENT=8


# ------------------------------------------------------------------------------
# 3. Rate Limiting (Optional)
# ------------------------------------------------------------------------------
# Set to 'true' to enable per-IP sliding window rate limiting
RATE_LIMIT_ENABLED=false

# Rate limiting window duration in seconds
RATE_LIMIT_WINDOW_S=60

# Maximum requests allowed per IP within the window
RATE_LIMIT_MAX_REQUESTS=10000
